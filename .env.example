# Copiá este archivo como .env.local y completá el valor.
# Cadena de conexión de Neon: Dashboard → tu proyecto → Connect → "Connection string".
# Solo la usa el servidor (/api); nunca se envía al navegador.
DATABASE_URL=postgresql://usuario:contraseña@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
